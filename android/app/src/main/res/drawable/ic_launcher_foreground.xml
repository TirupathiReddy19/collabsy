<?xml version="1.0" encoding="utf-8"?>
<!-- The Collabsy mark: two overlapping rounded squares (one outlined, one
     filled) tilted at opposing angles — same geometry as
     lib/core/widgets/app_logo.dart's _CollabsyMarkPainter, translated to a
     vector drawable so the adaptive icon (and, via it, Android 12+'s
     mandatory cold-start splash) shows the real mark instead of the
     default Flutter template logo. Kept within the ~66dp safe zone of the
     108x108 adaptive icon canvas so it isn't clipped by the OS mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="square_outline"
        android:pivotX="44.95"
        android:pivotY="44.95"
        android:rotation="-16.04">
        <path
            android:pathData="M34.71,28.95 L55.19,28.95 A5.76,5.76 0 0 1 60.95,34.71 L60.95,55.19 A5.76,5.76 0 0 1 55.19,60.95 L34.71,60.95 A5.76,5.76 0 0 1 28.95,55.19 L28.95,34.71 A5.76,5.76 0 0 1 34.71,28.95 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.2"
            android:fillColor="#00000000" />
    </group>

    <group
        android:name="square_fill"
        android:pivotX="63.05"
        android:pivotY="63.05"
        android:rotation="16.04">
        <path
            android:pathData="M52.81,47.05 L73.29,47.05 A5.76,5.76 0 0 1 79.05,52.81 L79.05,73.29 A5.76,5.76 0 0 1 73.29,79.05 L52.81,79.05 A5.76,5.76 0 0 1 47.05,73.29 L47.05,52.81 A5.76,5.76 0 0 1 52.81,47.05 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
