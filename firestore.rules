rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The one and only admin account — gated on Firebase Auth's own
    // (verified) email claim, not a client-writable field, so it can't be
    // self-granted. There's deliberately no signup path for this; the
    // account itself is created once, by hand, in the Firebase Console.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@collabsy.online';
    }

    // False once suspendUserAccount has put the `suspended` custom claim on
    // the caller's ID token (it lands on their next token refresh, which the
    // function forces by revoking refresh tokens). Gates the platform
    // actions a suspended account must not keep using: applying, messaging,
    // running campaigns, deliverables, notifications. Deliberately NOT
    // applied to Support, the account's own user doc, or reads, so the
    // suspended screen and the way to contact Support keep working.
    function notSuspended() {
      return !('suspended' in request.auth.token)
        || request.auth.token.suspended != true;
    }

    // A staff account (see staffAccounts/{uid} below) that's active and has
    // been granted the given sidebar section, e.g. '/support'. Mirrors
    // isAdmin()'s role as the real server-side boundary — the admin portal's
    // sidebar filtering is just UX, this is what actually stops a staff
    // account from touching data outside their assigned features.
    function isActiveStaffWithPermission(navPath) {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.permissions[navPath] == true;
    }

    // Whether either of the two given uids has blocked the other — a
    // block doc is keyed `{blockerId}_{blockedId}`, a one-directional
    // relationship, but either direction should stop the pair from
    // starting a chat or exchanging messages.
    function isBlocked(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b))
        || exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    // Whether a and b have a chat thread together — same shape as
    // isBlocked(), reusable because `chats/{chatId}` ids are the same kind
    // of deterministic composite key (`{brandId}_{creatorId}`, see
    // ChatRepository.chatId), just with an unknown role on each side, hence
    // checking both orderings.
    function isChatPartnerOf(a, b) {
      return exists(/databases/$(database)/documents/chats/$(a + '_' + b))
        || exists(/databases/$(database)/documents/chats/$(b + '_' + a));
    }

    // Notification types that only ever originate from an admin/staff
    // action (campaign review, brand/creator verification, support reply)
    // — never from ordinary Creator/Brand app code. Used by the
    // notifications create rule below to stop a regular user from forging
    // e.g. a fake "profile verified" or "campaign approved" push to
    // another user.
    function isAdminNotificationType(type) {
      return type in [
        'campaignApproved', 'campaignRejected',
        'profileVerified', 'profileRejected',
        'supportReply'
      ];
    }

    // Any active staff account, regardless of which specific features
    // they've been granted — used only for auditLogs' create rule, so
    // whatever action a staff account takes (in whichever section they're
    // allowed into) always gets logged, even if they can't read the Audit
    // Logs section itself.
    function isActiveStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staffAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffAccounts/$(request.auth.uid)).data.active == true;
    }

    // Matches the Supabase RLS boundary this replaces: any authenticated
    // user can read any profile (needed for discovery/chat/etc. later),
    // but only the owner can write their own. `role` is restricted to the
    // two real account types — without this, a signed-in user could set
    // their own role field to anything, including 'admin'.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        || (request.auth != null && request.auth.uid == userId
            && (!('role' in request.resource.data)
                || request.resource.data.role in ['creator', 'brand'])
            // `suspended`/`suspendedReason` only ever come from the
            // suspendUserAccount/reinstateUserAccount Cloud Functions —
            // an account can't un-suspend (or suspend) itself by writing
            // its own doc.
            && (!('suspended' in request.resource.data)
                || request.resource.data.suspended == (resource.data.suspended == true))
            && !('suspendedReason' in request.resource.data));

      // U1 phase A: email and push token move here, off the world-readable
      // `users/{uid}` doc above (`allow read: if request.auth != null` let
      // any signed-in stranger read every user's contact details — the
      // original bug). Self-write matches exactly what the app already
      // does (AuthRepository writes these fields on sign-up, sign-in and
      // token refresh); nothing but the account owner or admin ever needs
      // to touch this. During phase A the client dual-writes both this doc
      // and the old public fields, so a build 29/23 install — which only
      // ever reads the public ones — keeps working unaffected.
      match /private/contact {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email', 'fcmToken']);
      }

      // Phone is a SEPARATE doc from email/fcmToken above on purpose: the
      // in-app "Call" button on a chat needs the other participant's
      // number, and a Firestore rule can only grant a reader the WHOLE
      // document it names, never just one field — putting phone in the
      // same doc as email would hand a chat partner your email too.
      match /private/phone {
        allow read: if isAdmin()
          || (request.auth != null
              && (request.auth.uid == userId || isChatPartnerOf(request.auth.uid, userId)));
        allow write: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['phone']);
      }
    }

    // Creator-only post-signup details (languages/location) — same
    // ownership pattern as brandProfiles/users, except `verificationStatus`
    // (an admin's approve/reject decision after checking the creator's
    // connected Instagram) which only the admin may ever write.
    match /creatorProfiles/{userId} {
      allow read: if request.auth != null;
      // NOTE: on a merge write, request.resource.data reflects the full
      // post-merge document, not just the fields the client sent — so once
      // a creator is verified, "verificationStatus" is always present here
      // even on an unrelated bio/categories edit. Checking it's unchanged
      // (rather than absent) is what actually blocks the creator from
      // altering it while still letting merge writes through.
      allow write: if isAdmin()
        || isActiveStaffWithPermission('/verification/creators')
        || (request.auth != null && request.auth.uid == userId
            && (!('verificationStatus' in request.resource.data)
                || request.resource.data.verificationStatus == resource.data.verificationStatus));
    }

    // Brand-only profile extension (bio/industries/website) — same
    // ownership pattern as creatorProfiles/users, except `verificationStatus`
    // (an admin's approve/reject decision after checking the brand's
    // website + LinkedIn) which only the admin may ever write.
    match /brandProfiles/{userId} {
      allow read: if request.auth != null;
      // Same merge-write nuance as creatorProfiles above: request.resource.data
      // reflects the post-merge document, so a verified brand's existing
      // verificationStatus is always present here — check it's unchanged,
      // not merely present, or every profile edit gets denied.
      allow write: if isAdmin()
        || isActiveStaffWithPermission('/verification/brands')
        || (request.auth != null && request.auth.uid == userId
            && (!('verificationStatus' in request.resource.data)
                || request.resource.data.verificationStatus == resource.data.verificationStatus));
    }

    // Readable by any authenticated user (creators browse open campaigns),
    // but only the owning brand can create/modify their own.
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      // Every new campaign must start under review — the client always
      // sends this, but this rule stops a tampered client from creating an
      // already-active campaign directly, bypassing admin approval.
      allow create: if request.auth != null && notSuspended()
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.status == 'underReview';
      // The owning brand can edit its own campaign, but `status` is tightly
      // controlled: it can be left alone, or moved among the post-approval
      // states (pause / resume / close / reopen) — exactly what the brand's
      // status menu offers. A campaign sitting in 'underReview' or
      // 'rejected' can't have its status changed by the brand at all, and
      // can't be moved to 'underReview'/'rejected' either. (A rule that
      // only blocked the direct jump to 'active' let a brand reach it in two
      // writes via 'paused' or 'draft', skipping admin approval.)
      // Any other authenticated user (a creator viewing it) may only touch
      // the view-tracking fields, so opening a campaign's details can't be
      // used to tamper with it.
      allow update: if isAdmin()
        || isActiveStaffWithPermission('/campaigns/review')
        || (request.auth != null && notSuspended()
            && resource.data.brandId == request.auth.uid
            // `brandId` was never pinned here, so an owner could hand their
            // own campaign to a different account in one write — the owner
            // check above only ever verified who could still touch the
            // existing campaign, not that it stayed theirs afterward.
            && request.resource.data.brandId == resource.data.brandId
            && (request.resource.data.status == resource.data.status
                || (resource.data.status in ['active', 'paused', 'closed', 'expired']
                    && request.resource.data.status in ['active', 'paused', 'closed'])))
        // View-tracking from a creator opening the detail screen — auth
        // required (this used to have none at all), the count can only
        // ever go up by exactly 1 per write, and viewedByCreatorIds may
        // only (a) stay the same — a repeat view, since the client uses
        // arrayUnion — or (b) grow by exactly the caller's own id, the first
        // time they view it. Checking only that the caller's id was present
        // let other creators' ids ride along in the same write.
        || (request.auth != null && notSuspended()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['viewCount', 'viewedByCreatorIds'])
            && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1
            && request.resource.data.viewedByCreatorIds.hasAny([request.auth.uid])
            && request.resource.data.viewedByCreatorIds
                .hasAll(resource.data.get('viewedByCreatorIds', []))
            && (request.resource.data.viewedByCreatorIds.size()
                  == resource.data.get('viewedByCreatorIds', []).size()
                || (request.resource.data.viewedByCreatorIds.size()
                      == resource.data.get('viewedByCreatorIds', []).size() + 1
                    && !resource.data.get('viewedByCreatorIds', []).hasAny([request.auth.uid]))));
      allow delete: if request.auth != null && notSuspended()
        && resource.data.brandId == request.auth.uid;
    }

    // Visible only to the creator who applied and the owning brand — never
    // globally readable, unlike campaigns. The admin can read every
    // application for platform-wide oversight (dashboard counts, etc.).
    match /applications/{applicationId} {
      allow read: if isAdmin()
        || (request.auth != null
            && (resource.data.creatorId == request.auth.uid
                || resource.data.brandId == request.auth.uid));
      // The brand named on an application must be the campaign's real owner
      // (otherwise a creator could drop applications into any brand's
      // inbox), and nobody may apply to their own campaign (creatorId ==
      // brandId would make them both parties, able to accept their own
      // application and run the whole collaboration with themselves).
      allow create: if request.auth != null && notSuspended()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.creatorId != request.resource.data.brandId
        && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.brandId
            == request.resource.data.brandId;
      // `status` is the ONLY field either party may ever change here, and
      // only along the one transition each side actually owns — a creator
      // withdrawing their own still-open application, or the owning brand
      // accepting/rejecting a pending one. Without this, either side could
      // write any field to any value, including a creator self-accepting
      // their own application (skipping the brand's review entirely).
      allow update: if request.auth != null && notSuspended()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.creatorId == request.auth.uid
             && request.resource.data.status == 'withdrawn'
             && resource.data.status in ['pending', 'accepted'])
            || (resource.data.brandId == request.auth.uid
                && request.resource.data.status in ['accepted', 'rejected']
                && resource.data.status == 'pending'));
    }

    // One per accepted application — the creator submits proof of posted
    // content, the owning brand reviews it. Same visibility pattern as
    // applications: never globally readable, both parties can update
    // (creator submits, brand approves).
    match /deliverables/{deliverableId} {
      allow read: if request.auth != null
        && (resource.data.creatorId == request.auth.uid
            || resource.data.brandId == request.auth.uid);
      allow create: if request.auth != null && notSuspended()
        && request.resource.data.brandId == request.auth.uid
        && request.resource.data.status == 'pending';
      // The creator can only submit their own still-pending deliverable;
      // the owning brand can only approve one the creator has already
      // submitted. These two transitions are the only writes either side
      // can make — otherwise a creator could self-approve their own
      // deliverable without the brand ever reviewing it.
      allow update: if request.auth != null && notSuspended()
        && ((resource.data.creatorId == request.auth.uid
             && resource.data.status == 'pending'
             && request.resource.data.status == 'submitted'
             && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'submissionNote', 'submittedAt']))
            || (resource.data.brandId == request.auth.uid
                && resource.data.status == 'submitted'
                && request.resource.data.status == 'approved'
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'reviewedAt'])));
    }

    // The writer usually isn't the recipient (a creator applying writes a
    // notification FOR the brand, and vice versa), so creation can't be
    // owner-gated the way read/update are — see the shape/content
    // restrictions on `create` below instead.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Previously just `request.auth != null` — any signed-in user could
      // write an arbitrary title/body to ANY other user's notifications
      // (which sendPushOnNotificationCreate then forwards as a real push),
      // with no shape or length limits. This is a real phishing/spam
      // vector, so: a strict field allow-list, capped content length, a
      // fixed initial `read`/`createdAt`, and admin-only types (profile
      // verification, campaign decisions, support replies) blocked unless
      // the caller is actually admin/staff.
      allow create: if request.auth != null && notSuspended()
        && request.resource.data.keys().hasOnly(
            ['userId', 'type', 'title', 'body', 'referenceType', 'referenceId', 'read', 'createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.type in [
             'newApplication', 'applicationAccepted', 'applicationRejected', 'applicationWithdrawn',
             'newMessage', 'deliverableSubmitted', 'deliverableApproved',
             'campaignApproved', 'campaignRejected', 'profileVerified', 'profileRejected', 'supportReply'
           ]
        && (!isAdminNotificationType(request.resource.data.type) || isAdmin() || isActiveStaff())
        && request.resource.data.title is string && request.resource.data.title.size() < 200
        && request.resource.data.body is string && request.resource.data.body.size() < 1000
        && (!('referenceType' in request.resource.data) || request.resource.data.referenceType is string)
        && (!('referenceId' in request.resource.data) || request.resource.data.referenceId is string)
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      // Only the recipient marking their own notification read — same
      // shape as markRead/markAllRead, nothing else is ever legitimately
      // changed after creation.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Chat threads and their messages — visible only to the two
    // participants (never globally readable, same pattern as
    // applications). Messages check the parent chat's participants via
    // get() rather than their own fields, since every message in a thread
    // shares the same two participants.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && (resource.data.creatorId == request.auth.uid
            || resource.data.brandId == request.auth.uid);
      allow create: if request.auth != null && notSuspended()
        && (request.resource.data.creatorId == request.auth.uid
            || request.resource.data.brandId == request.auth.uid)
        && !isBlocked(request.resource.data.creatorId, request.resource.data.brandId);
      // Neither participant may ever rewrite who the other party is —
      // status/lastMessage(At) are shared, but each side may only touch
      // their own lastReadAt. Without a field allow-list here, a
      // participant could silently reassign creatorId/brandId to a
      // completely different account.
      allow update: if request.auth != null && notSuspended()
        && ((resource.data.creatorId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'lastMessage', 'lastMessageAt', 'creatorLastReadAt']))
            || (resource.data.brandId == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status', 'lastMessage', 'lastMessageAt', 'brandLastReadAt'])));

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId == request.auth.uid
              || get(/databases/$(database)/documents/chats/$(chatId)).data.brandId == request.auth.uid);
        allow create: if request.auth != null && notSuspended()
          && request.resource.data.senderId == request.auth.uid
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId == request.auth.uid
              || get(/databases/$(database)/documents/chats/$(chatId)).data.brandId == request.auth.uid)
          && !isBlocked(
            get(/databases/$(database)/documents/chats/$(chatId)).data.creatorId,
            get(/databases/$(database)/documents/chats/$(chatId)).data.brandId
          );
      }
    }

    // One doc per block relationship, keyed `{blockerId}_{blockedId}` —
    // a user can only create a block naming themself as the blocker (and
    // only delete their own, i.e. unblock), both parties (and admin) can
    // read it. `isBlocked()` above is what actually enforces this against
    // `chats`/`messages`, not this rule.
    //
    // The ownership check below is deliberately based on `blockId` (the
    // path itself), NOT `resource.data` — a client checking "did we block
    // each other" has to `.get()` both `{a}_{b}` and `{b}_{a}`, and one of
    // those two doc ids won't exist. Reading `resource.data.blockerId` on
    // a nonexistent doc evaluates against a null `resource`, which denies
    // the read with PERMISSION_DENIED instead of a clean "not found" —
    // that denial then fails the whole `Future.wait` client-side, so the
    // "am I blocked" check silently errors out and defaults to false.
    // Matching on the id itself needs no `resource` at all, so a `.get()`
    // on a doc that doesn't exist is allowed and returns exists:false.
    match /blocks/{blockId} {
      // The `resource.data.blockerId == request.auth.uid` disjunct exists
      // specifically for `watchBlockedByMe`'s `where('blockerId', ==, uid)`
      // list query (Settings' Blocked Accounts screen) — Firestore can only
      // grant a *list* query if the rule can be matched against the
      // query's own filter on a data field; a document-id-only condition
      // (the other two disjuncts below) works for single-doc `.get()`s
      // like `isBlockedEitherWay`, but Firestore rejects the entire list
      // request outright if the only guard is on `resource.id`, which is
      // exactly why Blocked Accounts showed "Couldn't load" with no doc
      // ever actually failing its own rule.
      allow read: if isAdmin()
        || isActiveStaffWithPermission('/trust-safety')
        || (request.auth != null
            && (resource.data.blockerId == request.auth.uid
                || blockId.split('_')[0] == request.auth.uid
                || blockId.split('_')[1] == request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedId;
      allow delete: if request.auth != null
        && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // One doc per user report — deliberately not readable by the reporter
    // after creation (this is a moderation queue, not a "my reports"
    // feature); only admin/trust-safety staff can read or mark reviewed.
    match /reports/{reportId} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/trust-safety');
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin() || isActiveStaffWithPermission('/trust-safety');
      allow delete: if false;
    }

    // Submitted from the public, unauthenticated web page linked from the
    // Play Console Data Safety form — Google Play requires a way to
    // request account deletion that doesn't depend on having the app
    // installed (or even ever having had an account signed in on this
    // device). Deliberately not readable by whoever submitted it — same
    // moderation-queue shape as `reports` — only admin/staff process these;
    // the actual deletion still goes through the same `deleteAccount`
    // Cloud Function as the in-app flow, triggered manually once staff
    // verify the request.
    //
    // Created ONLY by the `submitDeletionRequest` Cloud Function (Admin SDK,
    // which bypasses these rules): it validates the input and rate-limits
    // each visitor. An anonymous client create used to be allowed here, and
    // nothing stopped a script from flooding the queue.
    match /accountDeletionRequests/{requestId} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/deletion-requests');
      allow create: if false;
      allow update: if isAdmin() || isActiveStaffWithPermission('/deletion-requests');
      allow delete: if false;
    }

    // Submitted from the public, unauthenticated marketing website's
    // Brands page ("managed campaign" lead form) — same shape/rationale as
    // `accountDeletionRequests` above, deliberately not readable by
    // whoever submitted it. Only admin/staff with the `/campaign-requests`
    // permission ever see these.
    //
    // Created ONLY by the `submitCampaignRequest` Cloud Function (Admin SDK),
    // which applies the same field allow-list and length limits plus a
    // per-visitor rate limit; no client may create these directly.
    match /campaignRequests/{requestId} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/campaign-requests');
      allow create: if false;
      allow update: if (isAdmin() || isActiveStaffWithPermission('/campaign-requests'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // Instagram Business Login connection — profile snapshot + status
    // only. Readable by any authenticated user (same pattern as
    // users/creatorProfiles) so Brands can see a Creator's follower count
    // on their public profile; every write (connect/disconnect/refresh)
    // goes through a Cloud Function using the Admin SDK, which bypasses
    // these rules entirely, so clients never write here directly.
    match /instagram_accounts/{userId} {
      allow read: if request.auth != null;
      allow write: if false;

      // The actual access/refresh token. Never client-readable, not even
      // by the account's owner — only Cloud Functions touch this.
      match /private/{document} {
        allow read, write: if false;
      }
    }

    // Synced IG media items, one doc per media ID. Server-written only
    // (same reasoning as instagram_accounts); readable by the owning user.
    match /instagram_media/{mediaId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // One doc per user per calendar day (id: `{uid}_{yyyyMMdd}`), written
    // by the client whenever a sign-in is confirmed — the only signal this
    // app has for "was this user active today", since there's no separate
    // analytics SDK. Never globally readable by regular users, only by the
    // owner (who never needs to) and the admin (Platform Analytics).
    match /dailyActivity/{docId} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/analytics');
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // A record of every admin decision (campaign/brand approve or reject)
    // — write-once, no edits or deletes, so it stays a trustworthy history
    // of what actually happened rather than something that can be
    // rewritten after the fact.
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/audit');
      // The app always sends the signed-in admin/staff's own email as
      // `actorEmail` (see AdminAuditLogRepository.log) — requiring it match
      // the caller's real token, not just a client-supplied string, is what
      // actually stops one staff account from writing a history entry that
      // falsely credits (or blames) someone else, including the admin.
      allow create: if (isAdmin() || isActiveStaff())
        && request.resource.data.keys().hasOnly(['actorEmail', 'action', 'targetId', 'targetName', 'timestamp'])
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.action in [
             'campaignApproved', 'campaignRejected', 'brandVerified', 'brandRejected',
             'creatorVerified', 'creatorRejected', 'staffAccountCreated',
             'staffPermissionsUpdated', 'staffAccountForcedLogout', 'supportReplySent',
             'supportTicketResolved', 'supportTicketReopened', 'broadcastSent',
             'outreachSettingsUpdated', 'creatorSuspended', 'creatorReinstated',
             'brandSuspended', 'brandReinstated'
           ]
        && request.resource.data.targetId is string
        && request.resource.data.targetName is string
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // A staff account's own login/logout session history — write-once,
    // same shape as auditLogs. Read is admin-only (not permission-scoped)
    // since this is only ever viewed from Role Management, which is
    // always super-admin-only regardless of a staff account's own
    // permission map.
    match /staffLoginEvents/{eventId} {
      allow read: if isAdmin();
      // Same reasoning as auditLogs: the app only ever logs the signed-in
      // account's own login/logout (see AdminStaffLoginEventRepository),
      // never `forcedLogout` — that one is written only by the
      // forceLogoutStaffAccount Cloud Function via the Admin SDK, which
      // bypasses this rule entirely. Pinning uid/email to the caller's own
      // token stops a staff account from logging an event as someone else.
      allow create: if (isAdmin() || isActiveStaff())
        && request.resource.data.keys().hasOnly(['uid', 'email', 'roleName', 'type', 'timestamp'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.type in ['login', 'logout']
        && request.resource.data.roleName is string
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    // One doc per prospective influencer, keyed by their normalized
    // Instagram handle (dedup is just a doc-existence check on the id).
    // An intern (a staff account with the `/outreach-leads` permission)
    // creates the initial doc when they generate an outreach link — every
    // status transition after that (clicked/signedUp/onboardingComplete)
    // is written only by Cloud Functions (Admin SDK), so an intern can
    // never fake their own conversion numbers. The one exception is
    // `internConfirmedSent(At)` — a one-way false-to-true self-report the
    // intern makes after actually sending the DM (see the timed reveal in
    // intern_home_screen.dart). It's not proof of anything, just an
    // explicit claim instead of silence — still can't be faked as a
    // conversion metric since it's a separate field from `status`.
    match /leads/{handle} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/outreach-leads');
      // A strict field allow-list on create, so an intern can't pre-fill
      // conversion fields (clickCount, matchedUid, signedUpAt,
      // onboardingCompleteAt, internConfirmedSent) with made-up numbers —
      // those only ever come from Cloud Functions or the update rules
      // below. `contactEmail` is the influencer's public email the intern
      // spotted in their bio (see email_extractor.dart).
      allow create: if (isAdmin() || isActiveStaffWithPermission('/outreach-leads'))
        && request.resource.data.internId == request.auth.uid
        && request.resource.data.status == 'linkGenerated'
        && request.resource.data.keys().hasOnly([
             'instagramHandle', 'instagramUrl', 'internId', 'internEmail',
             'contactEmail', 'message', 'comment', 'status', 'createdAt',
             'clickCount', 'internConfirmedSent'])
        && request.resource.data.get('clickCount', 0) == 0
        && request.resource.data.get('internConfirmedSent', false) == false
        && (!('contactEmail' in request.resource.data)
            || (request.resource.data.contactEmail is string
                && request.resource.data.contactEmail.size() < 320))
        && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() || isActiveStaffWithPermission('/outreach-leads'))
        && resource.data.internId == request.auth.uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['internConfirmedSent', 'internConfirmedSentAt'])
            && request.resource.data.internConfirmedSent == true
            && resource.data.get('internConfirmedSent', false) == false
            && request.resource.data.internConfirmedSentAt == request.time
          ) || (
            // The intern's "I followed up again" self-report — can
            // happen more than once per lead, so it's a counter instead
            // of a one-way flip. See `logFollowUp` in
            // intern_leads_providers.dart.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFollowUpSentAt', 'followUpCount'])
            && request.resource.data.lastFollowUpSentAt == request.time
            && request.resource.data.followUpCount == resource.data.get('followUpCount', 0) + 1
          )
        );
      allow delete: if false;
    }

    // One doc per intern per day (`{internId}_{YYYY-MM-DD}`) — accumulates
    // seconds the intern actually spent with the outreach tool's tab
    // focused (see lib/intern/screens/intern_home_screen.dart's
    // WidgetsBindingObserver-driven 30s tick), not raw login-to-logout time.
    // Each write is capped to a 60s increment so a compromised/buggy client
    // can't inflate a shift arbitrarily in one call.
    match /internShiftStats/{statId} {
      allow read: if (resource.data.internId == request.auth.uid)
        || isAdmin() || isActiveStaffWithPermission('/intern-shift-report');
      allow create: if (isAdmin() || isActiveStaffWithPermission('/outreach-leads'))
        && request.resource.data.internId == request.auth.uid
        && statId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.keys().hasOnly(['internId', 'internEmail', 'date', 'activeSeconds', 'updatedAt'])
        && request.resource.data.activeSeconds is int
        && request.resource.data.activeSeconds >= 0 && request.resource.data.activeSeconds <= 60
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin() || isActiveStaffWithPermission('/outreach-leads'))
        && resource.data.internId == request.auth.uid
        && request.resource.data.internId == resource.data.internId
        && request.resource.data.date == resource.data.date
        && request.resource.data.keys().hasOnly(['internId', 'internEmail', 'date', 'activeSeconds', 'updatedAt'])
        && request.resource.data.activeSeconds is int
        && request.resource.data.activeSeconds - resource.data.get('activeSeconds', 0) >= 0
        && request.resource.data.activeSeconds - resource.data.get('activeSeconds', 0) <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Small admin-editable settings for the outreach tool — the DM message
    // template and (once the app is published) the real store URLs.
    match /config/outreachLinks {
      allow read: if isAdmin() || isActiveStaffWithPermission('/outreach-leads');
      allow write: if isAdmin();
    }

    // The force-update gate (checkAppVersion / AppBootstrap) — publicly
    // readable because it has to work before sign-in, and before Firebase
    // Auth has even resolved whether anyone is signed in at all. Holds no
    // sensitive data (just minimum build numbers, store links and a
    // message), so there's nothing a reader could misuse.
    match /config/appVersion {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One doc per prospective brand contact, keyed by their normalized
    // LinkedIn profile URL — mirrors `leads/{handle}` exactly, gated by its
    // own permission since it's a separate intern team/tool.
    match /brandLeads/{slug} {
      allow read: if isAdmin() || isActiveStaffWithPermission('/brand-outreach-leads');
      // Same allow-list rationale as `leads` above.
      allow create: if (isAdmin() || isActiveStaffWithPermission('/brand-outreach-leads'))
        && request.resource.data.internId == request.auth.uid
        && request.resource.data.status == 'linkGenerated'
        && request.resource.data.keys().hasOnly([
             'linkedinUrl', 'internId', 'internEmail', 'message', 'status',
             'createdAt', 'clickCount'])
        && request.resource.data.get('clickCount', 0) == 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Settings for the brand outreach tool — kept separate from
    // config/outreachLinks since the DM copy differs.
    match /config/brandOutreachLinks {
      allow read: if isAdmin() || isActiveStaffWithPermission('/brand-outreach-leads');
      allow write: if isAdmin();
    }

    // One doc per support *ticket* (auto-generated id, `userId` field says
    // who it belongs to) — a user can have many over time, so resolved
    // tickets stay as history instead of being overwritten. The admin is
    // the other side of every thread. Deliberately its own collection,
    // never mixed with `chats` (Creator<->Brand messaging).
    match /supportChats/{ticketId} {
      allow read: if isAdmin()
        || isActiveStaffWithPermission('/support')
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // First-ever creation of a new ticket — never with the admin/staff
      // -only triage fields set.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && !('category' in request.resource.data)
        && !('internalNotes' in request.resource.data)
        && !('internalNotesUpdatedAt' in request.resource.data)
        && !('internalNotesUpdatedBy' in request.resource.data);
      // Admin/staff can update anything (status, category, internal notes).
      // The ticket's own user can only ever touch status (self-reopening)
      // and the last-message fields (sending their own message) — never
      // category or internal notes, even if an admin already set them.
      allow update: if isAdmin()
        || isActiveStaffWithPermission('/support')
        || (request.auth != null && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'status',
                  'lastMessage',
                  'lastMessageAt',
                  'lastMessageSenderRole',
                ]));

      match /messages/{messageId} {
        allow read: if isAdmin()
          || isActiveStaffWithPermission('/support')
          || (request.auth != null
              && get(/databases/$(database)/documents/supportChats/$(ticketId)).data.userId == request.auth.uid);
        allow create: if isAdmin()
          || isActiveStaffWithPermission('/support')
          || (request.auth != null
              && get(/databases/$(database)/documents/supportChats/$(ticketId)).data.userId == request.auth.uid);
      }
    }

    // One doc per broadcast — a single shared message read by everyone in
    // `audience`, not fanned out into a per-recipient copy (unlike
    // `notifications`). Write-once, admin/staff-created, same shape as
    // `auditLogs`. Read isn't audience-gated here — broadcast content isn't
    // sensitive, and the app's own query already filters by role.
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isActiveStaffWithPermission('/broadcast');
      allow update, delete: if false;
    }

    // One doc per user — just their own "last opened the Announcements
    // screen" timestamp, same pattern as `userLastReadAt` on chats/tickets.
    // Admin/staff can also read across every doc (not just their own) —
    // needed for the "seen by N creators" count on the Broadcast screen.
    match /announcementReads/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || isAdmin()
            || isActiveStaffWithPermission('/broadcast'));
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Staff accounts created via Role Management (functions/createStaffAccount)
    // — never writable by clients directly, not even the staff member's own
    // doc, so a staff account can never edit its own permissions or
    // reactivate itself after being disabled. A staff account can read its
    // own doc (needed so the app itself can determine what it's allowed to
    // see) but nothing else about it.
    match /staffAccounts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }
  }
}
