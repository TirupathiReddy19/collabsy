{
  "//": "Emulator-only config for the local staging environment (see staging/README.md). Never passed to `firebase deploy` — only to `firebase emulators:start --config firebase.staging.json --project demo-collabsy`. The demo- project id keeps the whole suite fully offline: no real Firebase project is ever contacted.",
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "//hosting": "Only the first entry's 'port' is honored by the Hosting emulator for a multi-site config — the others are auto-assigned (see the banner `firebase emulators:start` prints, and staging/README.md, for the real ports).",
  "hosting": [
    {
      "site": "website",
      "public": "build/staging/web-website",
      "ignore": ["firebase.json", "firebase.staging.json", "**/.*"],
      "rewrites": [
        { "source": "/l/**", "function": "redirectLead" },
        { "source": "/bl/**", "function": "redirectBrandLead" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "site": "admin",
      "public": "build/staging/web-admin",
      "ignore": ["firebase.json", "firebase.staging.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "site": "intern",
      "public": "build/staging/web-intern",
      "ignore": ["firebase.json", "firebase.staging.json", "**/.*"],
      "rewrites": [
        { "source": "/l/**", "function": "redirectLead" },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "site": "brand-intern",
      "public": "build/staging/web-brand-intern",
      "ignore": ["firebase.json", "firebase.staging.json", "**/.*"],
      "rewrites": [
        { "source": "/bl/**", "function": "redirectBrandLead" },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ],
  "//emulators": "host 0.0.0.0 on every emulator (not the 127.0.0.1 default) so a scanner's own sandboxed container can reach them via host.docker.internal — see lib/core/config/emulator_config.dart and staging/README.md.",
  "emulators": {
    "auth": { "port": 9099, "host": "0.0.0.0" },
    "functions": { "port": 5001, "host": "0.0.0.0" },
    "firestore": { "port": 8080, "host": "0.0.0.0" },
    "storage": { "port": 9199, "host": "0.0.0.0" },
    "hosting": { "port": 5000, "host": "0.0.0.0" },
    "ui": { "enabled": true, "port": 4000, "host": "0.0.0.0" },
    "singleProjectMode": true
  }
}
